{
  "manifest_version": 3,
  "name": "Zillow Agent Scraper",
  "version": "1.0.0",
  "description": "Extract agent data and phone numbers from Zillow search results",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.zillow.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zillow Agent Scraper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zillow.com/homes/for_sale/*"],
      "js": ["content.js"]
    }
  ]
}
